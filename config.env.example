# Network alert settings.
# Copy this file to config.env, then change every line marked CHANGE.
# config.env holds your mail password. Never share it or commit it to Git.

# ------------------------------------------------------------------
# Name shown in the mail subject and as the sender.
# CHANGE: give your site a name, for example "Home Network".
# ------------------------------------------------------------------
SITE_NAME=Home Network

# ------------------------------------------------------------------
# Who receives the alert. Separate people with a comma.
# A display name is optional: Name <user@example.com>
# CHANGE: put your own email address here.
# ------------------------------------------------------------------
MAIL_TO=you@example.com

# ------------------------------------------------------------------
# How mail is sent.
#   smtp = log in to a mail account (Gmail, Outlook, ...). Use this at home.
#   mutt = hand mail to a mail server already set up on this machine
#          (for example an office PC with postfix). SMTP_* lines are ignored.
# ------------------------------------------------------------------
MAIL_METHOD=smtp

# CHANGE: the address the mail is sent from. Usually the same as SMTP_USER.
MAIL_FROM=you@gmail.com

# ------------------------------------------------------------------
# SMTP login. Only used when MAIL_METHOD=smtp.
#   Gmail:    smtp.gmail.com     port 587  starttls
#   Outlook:  smtp.office365.com port 587  starttls
#   Port 465: set SMTP_SECURITY=ssl
# For Gmail, turn on 2-Step Verification and create an App Password.
# Do not use your normal Gmail password.
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# CHANGE: your mail account.
SMTP_USER=you@gmail.com
# CHANGE: your app password. Keep this file private.
SMTP_PASSWORD=

# ------------------------------------------------------------------
# How many missed checks before the DOWN mail.
# With a 5-minute schedule: 1 = about 5 minutes, 3 = about 15 minutes.
# ------------------------------------------------------------------
FAIL_THRESHOLD=1

# Pings per check, and seconds to wait for each reply.
PING_COUNT=3
PING_TIMEOUT=2

# ------------------------------------------------------------------
# Addresses to ping. Format: ip=label;ip=label;ip=label
# The label is the name that appears in the mail.
#
# CHANGE: replace these IPs with YOUR addresses.
#   - Your router (the "default gateway"). Find it with:
#       Linux:   ip route | grep default
#       macOS:   netstat -nr | grep default
#       Windows: ipconfig   (look for "Default Gateway")
#   - Your ISP gateway, if you know it.
#   - Any device you care about (NAS, server, camera, ...).
#   - 8.8.8.8 checks that the internet itself is reachable.
#
# Ping each address once before adding it. An address that never
# answers ping will send a DOWN mail on the first check.
# ------------------------------------------------------------------
TARGETS=192.168.1.1=Home router;8.8.8.8=Internet (Google DNS)
